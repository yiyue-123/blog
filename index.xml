<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>文章 on 个人技术博客</title><link>https://blog.yiyue.tech/</link><description>Recent content in 文章 on 个人技术博客</description><generator>Hugo</generator><language>zh-CN</language><lastBuildDate>Mon, 25 May 2026 21:10:00 +0800</lastBuildDate><atom:link href="https://blog.yiyue.tech/index.xml" rel="self" type="application/rss+xml"/><item><title>树——简单</title><link>https://blog.yiyue.tech/posts/2026/05/%E6%A0%91%E7%AE%80%E5%8D%95/</link><pubDate>Mon, 25 May 2026 21:10:00 +0800</pubDate><guid>https://blog.yiyue.tech/posts/2026/05/%E6%A0%91%E7%AE%80%E5%8D%95/</guid><description>&lt;p&gt;树的最大深度&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#e6edf3;background-color:#0d1117;-moz-tab-size:2;-o-tab-size:2;tab-size:2;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-java" data-lang="java"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#ff7b72"&gt;public&lt;/span&gt;&lt;span style="color:#6e7681"&gt; &lt;/span&gt;&lt;span style="color:#ff7b72"&gt;int&lt;/span&gt;&lt;span style="color:#6e7681"&gt; &lt;/span&gt;&lt;span style="color:#d2a8ff;font-weight:bold"&gt;maxDepth&lt;/span&gt;(TreeNode&lt;span style="color:#6e7681"&gt; &lt;/span&gt;root)&lt;span style="color:#6e7681"&gt; &lt;/span&gt;{&lt;span style="color:#6e7681"&gt;
