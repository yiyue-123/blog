&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#6e7681"&gt; &lt;/span&gt;&lt;span style="color:#ff7b72"&gt;public&lt;/span&gt;&lt;span style="color:#6e7681"&gt; &lt;/span&gt;&lt;span style="color:#ff7b72"&gt;boolean&lt;/span&gt;&lt;span style="color:#6e7681"&gt; &lt;/span&gt;&lt;span style="color:#d2a8ff;font-weight:bold"&gt;judgeSysmmetric&lt;/span&gt;(TreeNode&lt;span style="color:#6e7681"&gt; &lt;/span&gt;left,&lt;span style="color:#6e7681"&gt; &lt;/span&gt;TreeNode&lt;span style="color:#6e7681"&gt; &lt;/span&gt;right)&lt;span style="color:#6e7681"&gt; &lt;/span&gt;{&lt;span style="color:#6e7681"&gt;
